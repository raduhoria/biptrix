# Copy to .env. Every value is optional; defaults are shown.

PORT=3000
# Interface to listen on; empty = all. Set to 127.0.0.1 behind nginx.
HOST=
# Public URL used in e-mail links (invitations, OTP, password reset).
APP_URL=http://localhost:3000
# Behind nginx/Cloudflare: trust X-Forwarded-For / X-Forwarded-Proto.
TRUST_PROXY=0
# Force Secure cookies (automatic when the request arrives over HTTPS).
COOKIE_SECURE=0
SESSION_TTL_HOURS=72
# Secret for TOTP seeds and OTP HMACs (from a secret manager in production).
# Unset → generated once into APP_SECRET_FILE.
APP_SECRET=
APP_SECRET_FILE=./data/.app-secret

# Data: sqlite (single server) or rqlite (HA, 3+ nodes).
DB_DRIVER=sqlite
SQLITE_PATH=./data/biptrix.db
# Comma-separated rqlite nodes; writes are redirected to the leader.
RQLITE_URL=
RQLITE_USER=
RQLITE_PASSWORD=
# weak | linearizable | strong | none
RQLITE_READ_CONSISTENCY=weak
# Unique per Node instance in a multi-node deployment (events, presence).
NODE_ID=
# 1 = poll the shared event log for events written by other Node instances.
CLUSTER=0

# Files live outside the webroot; in HA this must be shared storage.
FILES_DIR=./data/files
MAX_UPLOAD_MB=25
# Optional antivirus command, run as: <cmd> <file>; non-zero exit = rejected.
# Example: clamdscan --no-summary --fdpass
AV_SCAN_CMD=

# SMTP relay. Without SMTP_HOST, mails are printed to the console (dev only).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Biptrix

# WebRTC. ICE_SERVERS is a JSON array used as-is, e.g.
# [{"urls":"stun:stun.cloudflare.com:3478"}]
ICE_SERVERS=
# Short-lived TURN credentials from Cloudflare Realtime TURN.
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
# Or a coturn server with use-auth-secret (TURN REST credentials).
TURN_URLS=
TURN_SECRET=
# Cloudflare Realtime SFU (group meetings). The token stays on the server.
CF_SFU_APP_ID=
CF_SFU_APP_TOKEN=
# auto (SFU when configured) | sfu | mesh
MEDIA_TOPOLOGY=auto
# Peer-to-peer mesh limit per meeting until an SFU adapter is configured.
MESH_MAX_PARTICIPANTS=6
# Test only: force all media through TURN (simulates a restrictive NAT).
MEDIA_FORCE_RELAY=0
