# Production environment of Biptrix on ai-wizz. Kept in the GitLab CI/CD
# variable PROD_ENV (type File, protected); installed at every deploy as
# /etc/biptrix/biptrix.env. Never commit real values.

HOST=127.0.0.1
PORT=3400
APP_URL=https://talk.altbetexchange.com
TRUST_PROXY=1
COOKIE_SECURE=1
# Signed out after this many hours without use (sliding).
SESSION_TTL_HOURS=720
# 32+ random bytes, e.g. `openssl rand -base64 48`. Changing it invalidates
# MFA secrets and pending codes.
APP_SECRET=
# First-run /setup only opens with ?token=<SETUP_TOKEN>; remove after setup.
SETUP_TOKEN=

DB_DRIVER=sqlite
SQLITE_PATH=/var/lib/biptrix/biptrix.db
FILES_DIR=/var/lib/biptrix/files
MAX_UPLOAD_MB=100
# AV_SCAN_CMD=clamdscan --no-summary --fdpass

# Web Push (notifications on phones and computers, also with the app closed).
# Generate once with `node scripts/vapid-keys.js`; changing the pair makes
# every device subscribe again on its next visit. Empty = push off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tech@unicorndev.eu

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=BipTrix

CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
CF_SFU_APP_ID=
CF_SFU_APP_TOKEN=
MEDIA_TOPOLOGY=auto
